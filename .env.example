WEPAPER_DATA_DIR=/var/lib/wepaper
WEPAPER_SYNC_TOKEN=replace-with-a-long-random-token
WEPAPER_PUBLIC_URL=https://plainlist.space/wepaper
WEPAPER_HOST=127.0.0.1
WEPAPER_PORT=8788
WEPAPER_MAX_UPLOAD_BYTES=83886080

# Agent
WEPAPER_COLLECTION=wePaper,Agent Memory
WEPAPER_SERVER_URL=https://plainlist.space/wepaper
WEPAPER_POLL_SECONDS=60
WEPAPER_STATE_DIR=~/.config/wepaper
